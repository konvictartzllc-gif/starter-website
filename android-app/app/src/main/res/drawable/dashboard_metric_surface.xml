<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/dex_panel"
                android:startColor="@color/dex_panel_elevated" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/dex_border" />
        </shape>
    </item>
    <item android:bottom="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@android:color/transparent"
                android:startColor="@color/dex_metric_highlight" />
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <solid android:color="@color/dex_border_soft" />
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp" />
        </shape>
    </item>
</layer-list>
